{
  "cdz-avatar-stack": {
    "overlap": {
      "sm": { "$value": "{spacing.2}", "$type": "dimension" },
      "md": { "$value": "{spacing.3}", "$type": "dimension" },
      "lg": { "$value": "{spacing.4}", "$type": "dimension" }
    },
    "ring": {
      "width": { "$value": "2px", "$type": "dimension" },
      "color": { "$value": "{color.page.background}", "$type": "color" }
    },
    "color": {
      "overflow-background": { "$value": "{color.status.neutral.background}", "$type": "color" },
      "overflow-text": { "$value": "{color.status.neutral.foreground}", "$type": "color" }
    },
    "typography": {
      "overflow": {
        "font-family": { "$value": "{typography.caption.font-family}", "$type": "fontFamily" },
        "font-weight": { "$value": "{typography.label.font-weight}", "$type": "fontWeight" }
      }
    }
  }
}
