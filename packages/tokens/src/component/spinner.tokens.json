{
  "cdz-spinner": {
    "sizing": {
      "sm": { "$value": "{spacing.4}", "$type": "dimension" },
      "md": { "$value": "1.25rem", "$type": "dimension" },
      "lg": { "$value": "1.5rem", "$type": "dimension" }
    },
    "stroke-width": { "$value": "2.5", "$type": "number" },
    "track-opacity": { "$value": "0.25", "$type": "number" },
    "duration": { "$value": "900ms", "$type": "duration" },
    "reduced-motion-duration": { "$value": "1600ms", "$type": "duration" }
  }
}
