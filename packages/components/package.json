{
  "name": "@kdenza/components",
  "version": "0.1.1",
  "description": "Web Components accesibles construidos con Lit, con tokens de diseño DTCG y modo claro/oscuro",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdenza/cadenza.git",
    "directory": "packages/components"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Mónica Castillo (https://github.com/moni-kyrah)",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -r src/styles dist/styles",
    "analyze": "cem analyze",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "prepublishOnly": "npm run build && npm run analyze"
  },
  "dependencies": {
    "@kdenza/tokens": "^0.1.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^5.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-chrome": "^1.0.1",
    "typescript": "^7.0.2"
  }
}
